# ---------------------------------------------------------------------------
# Ready-to-fill production environment for an EXISTING EC2 host + RDS + ElastiCache.
#
#   cp infra/host/env.example .env
#   nano .env      # replace every CHANGEME
#
# Never commit the real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# --- Core ---
# ENVIRONMENT=production makes mcp_servers/common.py:check_token() STRICT:
# every MCP_*_TOKEN below must be non-empty or MCP calls raise AuthError.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- RDS Postgres 16 (pgvector) ---
# Use the RDS MASTER user: init_db() runs `CREATE EXTENSION IF NOT EXISTS vector`
# and only an rds_superuser may install extensions. sslmode=require is standard
# for RDS. Keep the `postgresql+psycopg://` scheme.
DATABASE_URL=postgresql+psycopg://triage:CHANGEME@CHANGEME.rds.amazonaws.com:5432/triage?sslmode=require

# --- ElastiCache Redis 7 ---
# With in-transit TLS + AUTH token (recommended): rediss://default:TOKEN@HOST:6379/0
# Without TLS/auth (plain):                        redis://HOST:6379/0
REDIS_URL=rediss://default:CHANGEME_AUTH_TOKEN@CHANGEME.cache.amazonaws.com:6379/0

# --- Worker -> API (compose service name; keep as-is) ---
TRIAGE_API_URL=http://api:8000

# --- LLM ---
ANTHROPIC_API_KEY=CHANGEME

# --- Models (cheap classification vs. stronger drafting) ---
MODEL_CLASSIFY=claude-3-5-haiku-latest
MODEL_DECIDE=claude-3-5-sonnet-latest
MODEL_DRAFT=claude-3-5-sonnet-latest
MODEL_JUDGE=claude-3-5-sonnet-latest
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP servers ---
# The orchestrator runs tools in-process (agent/tools.py), so no MCP containers
# are deployed; the tokens are still required because ENVIRONMENT=production.
# Generate four values with: openssl rand -hex 16
MCP_TRANSPORT=stdio
MCP_TICKETING_URL=http://ticketing-mcp:8801/mcp
MCP_KB_URL=http://kb-mcp:8802/mcp
MCP_CUSTOMER_URL=http://customer-mcp:8803/mcp
MCP_POLICY_URL=http://policy-mcp:8804/mcp
MCP_TICKETING_TOKEN=CHANGEME
MCP_KB_TOKEN=CHANGEME
MCP_CUSTOMER_TOKEN=CHANGEME
MCP_POLICY_TOKEN=CHANGEME

# --- Safety thresholds ---
CONFIDENCE_ESCALATE_THRESHOLD=0.65

# --- Eval ---
# Must be durable. The default sqlite:///./evals_results.db would live on the
# container filesystem and lose eval history on every redeploy. Point at RDS.
EVAL_DB_URL=postgresql+psycopg://triage:CHANGEME@CHANGEME.rds.amazonaws.com:5432/triage?sslmode=require
JUDGE_RUBRIC_VERSION=v1
