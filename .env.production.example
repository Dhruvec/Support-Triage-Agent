# ---------------------------------------------------------------------------
# Production environment template for the single-EC2 deployment.
#
# Copy to `.env` on the host and fill in real values, or let
# infra/aws/user-data.sh render it from SSM (parameter `triage/env`).
#
# NEVER commit the real `.env` - it is already gitignored.
# ---------------------------------------------------------------------------

# --- Container image (substituted by docker-compose.prod.yml) ---
TRIAGE_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/triage-agent:latest

# --- Core ---
# ENVIRONMENT=production makes mcp_servers/common.py.check_token() STRICT:
# every MCP_*_TOKEN below must be set or MCP calls raise AuthError.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Datastores (managed AWS) ---
# RDS Postgres 16 with the `vector` extension (pgvector). init_db() runs
# `CREATE EXTENSION IF NOT EXISTS vector`, so the connecting user must be the
# RDS master user (rds_superuser).
DATABASE_URL=postgresql+psycopg://triage:CHANGE_ME@triage-db.abcdefghijkl.us-east-1.rds.amazonaws.com:5432/triage?sslmode=require

# ElastiCache Redis 7 with in-transit encryption + AUTH token -> the scheme
# MUST be `rediss://` (TLS) and the token is the password.
REDIS_URL=rediss://default:CHANGE_ME_AUTH_TOKEN@triage-cache.abcdefghijkl.use1.cache.amazonaws.com:6379/0

# Worker -> API. Matches the compose service name (apps/worker/main.py reads
# this as TRIAGE_API_URL, defaulting to http://localhost:8000 otherwise).
TRIAGE_API_URL=http://api:8000

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
MODEL_CLASSIFY=claude-3-5-haiku-latest
MODEL_DECIDE=claude-3-5-sonnet-latest
MODEL_DRAFT=claude-3-5-sonnet-latest
MODEL_JUDGE=claude-3-5-sonnet-latest
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP servers ---
# The orchestrator currently runs tools in-process (agent/tools.py
# get_tool_client(force_in_process=True) + MCPToolClient._call_sync() raises
# NotImplementedError), so no MCP container is deployed. Tokens are still set
# because ENVIRONMENT=production enforces them.
MCP_TRANSPORT=stdio
MCP_TICKETING_URL=http://ticketing-mcp:8801/mcp
MCP_KB_URL=http://kb-mcp:8802/mcp
MCP_CUSTOMER_URL=http://customer-mcp:8803/mcp
MCP_POLICY_URL=http://policy-mcp:8804/mcp
MCP_TICKETING_TOKEN=CHANGE_ME_TICKETING_TOKEN
MCP_KB_TOKEN=CHANGE_ME_KB_TOKEN
MCP_CUSTOMER_TOKEN=CHANGE_ME_CUSTOMER_TOKEN
MCP_POLICY_TOKEN=CHANGE_ME_POLICY_TOKEN

# --- Safety thresholds ---
CONFIDENCE_ESCALATE_THRESHOLD=0.65

# --- Eval ---
# MUST be durable. The default `sqlite:///./evals_results.db` would live on the
# container's ephemeral filesystem and lose all eval history on redeploy.
# Points at the same RDS instance; eval tables (eval_runs/eval_results) are
# separate from the application tables.
EVAL_DB_URL=postgresql+psycopg://triage:CHANGE_ME@triage-db.abcdefghijkl.us-east-1.rds.amazonaws.com:5432/triage?sslmode=require
JUDGE_RUBRIC_VERSION=v1
