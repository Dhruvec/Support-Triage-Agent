# --- Core ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Datastores ---
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
ANTHROPIC_API_KEY=
# Model routing (cheap classification vs. stronger drafting)
MODEL_CLASSIFY=claude-3-5-haiku-latest
MODEL_DECIDE=claude-3-5-sonnet-latest
MODEL_DRAFT=claude-3-5-sonnet-latest
MODEL_JUDGE=claude-3-5-sonnet-latest
# Embeddings (kb-mcp / dedupe)
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP servers ---
# stdio for dev, streamable HTTP for deploy
MCP_TRANSPORT=stdio
MCP_TICKETING_URL=http://localhost:8801/mcp
MCP_KB_URL=http://localhost:8802/mcp
MCP_CUSTOMER_URL=http://localhost:8803/mcp
MCP_POLICY_URL=http://localhost:8804/mcp
MCP_TICKETING_TOKEN=dev-ticketing-token
MCP_KB_TOKEN=dev-kb-token
MCP_CUSTOMER_TOKEN=dev-customer-token
MCP_POLICY_TOKEN=dev-policy-token

# --- Safety thresholds ---
CONFIDENCE_ESCALATE_THRESHOLD=0.65

# --- Eval ---
EVAL_DB_URL=sqlite:///./evals_results.db
JUDGE_RUBRIC_VERSION=v1
